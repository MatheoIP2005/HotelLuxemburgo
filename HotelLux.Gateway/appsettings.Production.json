{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "accommodation": {
        "Destinations": {
          "api": {
            "Address": "https://hotellux-accommodation.onrender.com/"
          }
        }
      },
      "reservation": {
        "Destinations": {
          "api": {
            "Address": "https://hotellux-reservation.onrender.com/"
          }
        }
      },
      "stay": {
        "Destinations": {
          "api": {
            "Address": "https://hotellux-stay.onrender.com/"
          }
        }
      },
      "auth": {
        "Destinations": {
          "api": {
            "Address": "https://hotellux-auth.onrender.com/"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false
        }
      },
      "finance": {
        "Destinations": {
          "api": {
            "Address": "https://hotellux-finance.onrender.com/"
          }
        }
      },
      "audit": {
        "Destinations": {
          "api": {
            "Address": "https://hotellux-audit.onrender.com/"
          }
