{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "accommodation": {
        "Destinations": {
          "api": {
            "Address": "RENDER_URL_ACCOMMODATION"
          }
        }
      },
      "reservation": {
        "Destinations": {
          "api": {
            "Address": "RENDER_URL_RESERVATION"
          }
        }
      },
      "stay": {
        "Destinations": {
          "api": {
            "Address": "RENDER_URL_STAY"
          }
        }
      },
      "auth": {
        "Destinations": {
          "api": {
            "Address": "RENDER_URL_AUTH"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false
        }
      },
      "finance": {
        "Destinations": {
          "api": {
            "Address": "RENDER_URL_FINANCE"
          }
        }
      },
      "audit": {
        "Destinations": {
          "api": {
            "Address": "RENDER_URL_AUDIT"
          }
        }
      }
    }
  }
}
